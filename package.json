{
  "name": "@local/dsh-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal sync hub for DSH sessions and workspace snapshots",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-sync": "./bin/dsh-sync.mjs",
    "dsh-sync-hub": "./bin/hub.mjs"
  },
  "files": [
    "index.js",
    "bin",
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
