{
  "name": "@yamsengyi/dsh-session-sync",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "description": "Personal sync hub for DSH sessions and workspace snapshots",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session-sync",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yamsengyi/dsh-session-sync.git"
  },
  "homepage": "https://github.com/yamsengyi/dsh-session-sync#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-session-sync": "./bin/session-sync.mjs",
    "dsh-session-sync-hub": "./bin/hub.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/local.test.mjs test/manifest.test.mjs test/plugin.test.mjs test/recovery.test.mjs test/pairing.test.mjs test/ui-api.test.mjs test/update-check.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
